# URL of the deployed portfolio-chatbot-backend's chat endpoint.
# During local development this can point at your local backend (python app.py).
NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:8080/api/chat

# Supabase project (Project Settings -> API in the Supabase dashboard).
# The anon key is safe to expose to the browser; Row Level Security restricts what it can do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Chatbot sync (server-only -- no NEXT_PUBLIC_ prefix). After you save content in /admin, the
# site tells the chatbot backend to re-read Supabase. The secret must equal the backend's
# SYNC_WEBHOOK_SECRET. Leave both unset to disable syncing (the site itself is unaffected).
CHATBOT_SYNC_URL=http://localhost:8080/api/admin/sync-kb
CHATBOT_SYNC_SECRET=

# Not needed here: the service role key (Settings -> API -> service_role in the Supabase
# dashboard) is never imported by this app -- every read/write goes through the
# cookie-authenticated client and Row Level Security. Only fetch it if you write a
# separate privileged script of your own; never commit it or put it in NEXT_PUBLIC_*.

# GitHub contribution graph (server-only -- no NEXT_PUBLIC_ prefix, never exposed to the
# browser). Optional: the numeric GitHub stats (repos/stars/followers) work without this
# via the public REST API, but the green-square contribution calendar needs GraphQL,
# which requires a token. Create one at https://github.com/settings/tokens -- a classic
# token with NO scopes checked is enough, since this only ever reads public data. Leave
# unset to skip the calendar (the rest of the GitHub section still works).
GITHUB_TOKEN=

# Email notification when someone submits "Request a meeting" (server-only -- no
# NEXT_PUBLIC_ prefix). Sent via Resend (https://resend.com, free tier). Optional: the
# submission is always saved to Supabase (see /admin/meeting-requests) regardless of
# whether this is configured -- leave RESEND_API_KEY unset to skip the email entirely.
# The notification goes to the email set in /admin/profile's Contact section.
RESEND_API_KEY=
# Only needed once you've verified your own domain in Resend; until then, the default
# (shown below) works fine since it only ever sends to your own address.
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
