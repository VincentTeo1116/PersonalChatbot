# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=portfolio-chatbot
PINECONE_NAMESPACE=portfolio-kb

# Gemini -- embeddings only (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# text-embedding-004 was retired for embedContent; gemini-embedding-001 is the
# current replacement (see src/services/gemini_service.py for the dimension note).
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Groq -- answer generation (get a key at https://console.groq.com/keys). Groq's model
# lineup changes often -- if GROQ_CHAT_MODEL ever 404s, run this to see what your key
# currently has access to: python -c "from groq import Groq; import os; print([m.id for m in Groq(api_key=os.environ['GROQ_API_KEY']).models.list().data])"
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Retrieval
TOP_K=4
MIN_SCORE=0.55

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Sync webhook secret
SYNC_WEBHOOK_SECRET=

# CORS: your portfolio site's origin(s), comma-separated
ALLOWED_ORIGINS=https://your-portfolio-domain.com
