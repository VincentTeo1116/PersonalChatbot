# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=portfolio-chatbot
PINECONE_NAMESPACE=portfolio-kb

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_CHAT_MODEL=models/gemini-2.5-flash

# --- Retrieval ---
TOP_K=4
MIN_SCORE=0.55

# --- Sync webhook secret (must match the SYNC_SECRET script property in Apps Script) ---
SYNC_WEBHOOK_SECRET=

# --- CORS: your portfolio site's origin(s), comma-separated ---
ALLOWED_ORIGINS=https://your-portfolio-domain.com
